# CMake가 자동 생성하는 빌드 파일
build/

# VS Code 개인 설정
.vscode/

# 입력 영상은 용량이 크므로 제외
videos/*
!videos/.gitkeep

# 프로그램이 생성한 결과 영상 제외
results/*.avi
results/*.mp4
results/*_frames.csv

# 실행 로그 (raw_frame_log.csv / run_summary.json)
results/runs/

# AI 모델 파일 제외
*.onnx

# Python 가상환경
.venv/

# YOLO 원본 모델
*.pt

# Jetson 진단 로그
results/diagnostics/
build_noft/

# Benchmark Harness 산출물
results/benchmark_sessions/
results/benchmark_archives/